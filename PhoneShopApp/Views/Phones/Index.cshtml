@model List<PhoneShopApp.Models.Phone>

<h2>Kínálatunk</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="brandId" asp-items="ViewBag.Brands" class="form-select">
            <option value="">-- Összes márka --</option>
        </select>
    </div>
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Keresés modellre..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Szűrés</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Alaphelyzet</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success float-end">+ Új telefon</a>
        }
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Márka</th>
            <th>Modell</th>
            <th>Ár</th>
            <th>Készlet</th>
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Brand?.Name</td>
                <td>@p.ModelName</td>
                <td>@p.Price.ToString("N0") Ft</td>
                <td>
                    @if (p.StockQuantity > 0)
                    {
                        <span class="badge bg-success">@p.StockQuantity db</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Elfogyott</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Szerkesztés</a>
                    }
                    @if (User.Identity?.IsAuthenticated == true && p.StockQuantity > 0)
                    {
                        <form asp-controller="Orders" asp-action="Create" method="post" class="d-inline-flex gap-1">
                            <input type="hidden" name="phoneId" value="@p.Id" />
                            <input type="number" name="quantity" value="1" min="1" max="@p.StockQuantity" class="form-control form-control-sm" style="width: 65px;" />
                            <button type="submit" class="btn btn-sm btn-primary">Megrendelem</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
