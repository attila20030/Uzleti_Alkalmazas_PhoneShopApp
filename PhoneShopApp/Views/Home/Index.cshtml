@{
    ViewData["Title"] = "Kezdőlap";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">PhoneShop – Prémium Mobiltelefon Szaküzlet</h1>
        <p class="col-md-8 fs-5 text-light">
            Fedezd fel a legújabb Apple, Samsung és Xiaomi okostelefonokat valós idejű készletinformációval és azonnali online rendeléssel.
        </p>
        <div class="d-flex gap-2 mt-4">
            <a asp-controller="Phones" asp-action="Index" class="btn btn-primary btn-lg px-4">
                Teljes kínálat megtekintése
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                    Regisztráció vásárláshoz
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 py-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Apple készülékek</h5>
                <p class="card-text text-muted">A legújabb iPhone modellek hivatalos garanciával, azonnal raktárról.</p>
                <a asp-controller="Phones" asp-action="Index" asp-route-brandId="1" class="btn btn-outline-primary btn-sm">Apple kínálat &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Samsung Galaxy</h5>
                <p class="card-text text-muted">Csúcskategóriás Galaxy S széria és megbízható középkategóriás modellek.</p>
                <a asp-controller="Phones" asp-action="Index" asp-route-brandId="2" class="btn btn-outline-primary btn-sm">Samsung kínálat &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Xiaomi okostelefonok</h5>
                <p class="card-text text-muted">Kiváló ár-érték arányú Redmi és Xiaomi készülékek széles választékban.</p>
                <a asp-controller="Phones" asp-action="Index" asp-route-brandId="3" class="btn btn-outline-primary btn-sm">Xiaomi kínálat &rarr;</a>
            </div>
        </div>
    </div>
</div>
